# Copy to scripts/release.env, which git ignores, and fill in your own values.
# Read by scripts/bundle.sh. Every line uses ${VAR:-default} so an exported
# variable still overrides the file.

# Reverse-DNS id for your build. macOS remembers Gatekeeper and keychain
# decisions against it, so pick one you intend to keep.
BUNDLE_ID=${BUNDLE_ID:-com.example.claude-usage}

# Team id used for the widget's App Group. The bundle script reads this from a
# normal Developer ID identity, so set it only if SIGN_IDENTITY is a hash or a
# name that does not end in the team id.
# TEAM_ID=${TEAM_ID:-ABCDE12345}

# notarytool credentials profile. Create it once with your Apple ID, your team
# id from developer.apple.com/account, and an app-specific password from
# appleid.apple.com. The password lands in your login keychain, not here:
#
#   xcrun notarytool store-credentials <profile> \
#     --apple-id you@example.com --team-id <TEAM_ID> --password <app-specific>
#
# Leave empty to sign without notarizing.
NOTARY_PROFILE=${NOTARY_PROFILE:-}

# Only needed if you hold more than one Developer ID Application certificate.
# Otherwise the script reads it from your keychain.
# SIGN_IDENTITY=${SIGN_IDENTITY:-Developer ID Application: Your Name (TEAMID)}
